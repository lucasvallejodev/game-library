# Fail fast if the local Node does not satisfy "engines" in package.json.
engine-strict=true

# Keep node_modules strict: a package may only import what it declares.
# This is what stops phantom dependencies from creeping in across the monorepo.
hoist=false
shamefully-hoist=false

# Workspace packages always resolve to the local source, never the registry.
link-workspace-packages=true
prefer-workspace-packages=true

# Exact versions on install; the catalog in pnpm-workspace.yaml is the single
# place versions are chosen.
save-exact=true
