# ==============================================================================
# Game Library — environment
#
# Copy to .env and fill in. .env is gitignored; this file is committed and must
# never contain real values.
#
#   cp .env.example .env
#
# apps/api/src/env.ts parses these with Zod at boot and EXITS on invalid config,
# so a missing key fails at startup rather than at 3am on first use.
# See docs/security.md §8.
# ==============================================================================

# General --------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug

# Postgres -------------------------------------------------------------------
# POSTGRES_* are consumed by the container. DATABASE_URL is what the app reads.
# Host-side tools (drizzle-kit, psql) connect via localhost:${POSTGRES_PORT};
# containers connect to the service name `postgres` on 5432.
POSTGRES_USER=gamelib
POSTGRES_PASSWORD=change-me
POSTGRES_DB=gamelib
POSTGRES_PORT=5432
DATABASE_URL=postgresql://gamelib:change-me@localhost:5432/gamelib

# Redis ----------------------------------------------------------------------
# Holds the Twitch app token, the IGDB response cache, and rate-limit counters.
# See docs/architecture.md §6.
REDIS_PASSWORD=change-me
REDIS_PORT=6379
REDIS_URL=redis://:change-me@localhost:6379

# Object storage (MinIO / S3) ------------------------------------------------
# STORAGE_DRIVER picks the primary driver. When it is `s3` and MinIO is
# unreachable, the API falls back to local disk and records which driver
# actually stored each object on media_assets.storage_driver.
# See docs/architecture.md §7.
STORAGE_DRIVER=s3
STORAGE_LOCAL_PATH=./storage
MAX_UPLOAD_BYTES=8388608

MINIO_ROOT_USER=gamelib
MINIO_ROOT_PASSWORD=change-me
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=game-library-media
S3_ACCESS_KEY=gamelib
S3_SECRET_KEY=change-me
S3_FORCE_PATH_STYLE=true

# Auth -----------------------------------------------------------------------
# BETTER_AUTH_SECRET signs sessions. Generate a fresh one per environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=change-me-generate-a-real-secret
BETTER_AUTH_URL=http://localhost:4000

# Google OAuth. Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: ${BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ==============================================================================
# IGDB / Twitch — SERVER ONLY
#
# These authenticate *our application* to IGDB via the Twitch OAuth2
# client-credentials grant. There is no user identity involved, which is
# exactly why the secret must never leave the server.
#
# NEVER prefix these NEXT_PUBLIC_. NEVER pass them to the web container.
# NEVER return them from an endpoint. CI greps apps/web for `TWITCH_`.
# See docs/security.md §4.
#
# Register an application at https://dev.twitch.tv/console/apps
# ==============================================================================
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# API ------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=4000
# CORS allowlist for the web origin. Never `*` — see docs/security.md §2.
WEB_ORIGIN=http://localhost:3000

# Web ------------------------------------------------------------------------
WEB_PORT=3000
# Public by definition: this value is inlined into the browser bundle.
# Only ever put non-secret values behind NEXT_PUBLIC_.
NEXT_PUBLIC_API_URL=http://localhost:4000
