{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Game Library — base",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",

    // Type safety. `strict` is the floor, not the ceiling — the extras below
    // are the ones that catch real bugs in this codebase's shape.
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowUnreachableCode": false,

    // `exactOptionalPropertyTypes` is deliberately OFF. It is correct in
    // principle but fights constantly with third-party types (Zod inference,
    // React props, Drizzle partial selects), producing noise rather than
    // caught bugs. Revisit if that ecosystem friction improves.

    // Interop
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    // These packages are typechecked, not emitted; apps handle their own build.
    "noEmit": true
  }
}
